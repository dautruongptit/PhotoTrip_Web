# URL gốc của backend Spring Boot (bao gồm "/api", không có dấu / ở cuối).
# Backend thật (travelPhoto-API) mặc định chạy port 8085.
# LƯU Ý: application.yml của backend hiện có "server.servlet.context-path: /api/v1"
# trùng với "/api/..." đã có sẵn trong từng Controller, nên URL thật sẽ có "/v1"
# ở giữa. Khuyến nghị xóa dòng context-path đó ở backend cho URL sạch như dưới đây.
VITE_API_BASE_URL=http://localhost:8085/api

# Đường dẫn bắt đầu đăng nhập Google (Spring Security OAuth2 mặc định, KHÔNG nằm
# dưới "/api"). Chỉ cần đổi nếu backend có context-path khác (vd giữ "/api/v1" thì
# đổi thành "/api/v1/oauth2/authorization/google").
VITE_OAUTH2_LOGIN_PATH=/oauth2/authorization/google

# Chế độ thanh toán VNPay:
#   mock -> mô phỏng màn hình VNPay ngay trong trình duyệt, không cần backend (để dựng UI)
#   real -> gọi backend tạo link thanh toán thật rồi chuyển hướng sang VNPay
#   (Backend travelPhoto-API CHƯA có endpoint VNPay, giữ "mock" cho tới khi code xong)
VITE_PAYMENT_MODE=mock

# Ghi chú: KHÔNG còn cần VITE_GOOGLE_CLIENT_ID ở frontend nữa — Client ID/Secret
# giờ chỉ cấu hình ở backend (application.yml: spring.security.oauth2.client.registration.google),
# vì đăng nhập Google được xử lý hoàn toàn phía backend (Spring Security OAuth2 Login).
